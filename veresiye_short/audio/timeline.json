{
 "duration": 33.85,
 "segments": [
  {
   "start": 0.0,
   "text": "Eskiden kredi kartı yoktu…"
  },
  {
   "start": 1.85,
   "text": "ama herkesin bir limiti vardı."
  },
  {
   "start": 3.56,
   "text": "Hem de bankada değil,"
  },
  {
   "start": 4.76,
   "text": "köşedeki bakkalın tezgâhının altındaki o çizgili defterde."
  },
  {
   "start": 7.99,
   "text": "\"Babam yazdırır\" demen yeterdi."
  },
  {
   "start": 9.78,
   "text": "Ne şifre sorulurdu ne kimlik."
  },
  {
   "start": 11.4,
   "text": "Ekmek,"
  },
  {
   "start": 11.96,
   "text": "süt,"
  },
  {
   "start": 12.47,
   "text": "bir de gizlice aldığın sakız…"
  },
  {
   "start": 14.08,
   "text": "hepsi kurşun kalemle yazılırdı."
  },
  {
   "start": 15.81,
   "text": "Ay sonu baban gelir,"
  },
  {
   "start": 17.06,
   "text": "borç kapanır,"
  },
  {
   "start": 17.96,
   "text": "sayfanın üstü çizilirdi."
  },
  {
   "start": 19.48,
   "text": "Faiz yoktu,"
  },
  {
   "start": 20.39,
   "text": "gecikme cezası yoktu."
  },
  {
   "start": 21.81,
   "text": "Bir tek güven vardı."
  },
  {
   "start": 23.29,
   "text": "O defter bir hesap defteri değildi aslında."
  },
  {
   "start": 25.96,
   "text": "Bütün mahallenin birbirine güvendiğini gösteren bir defterdi."
  },
  {
   "start": 29.09,
   "text": "Senin bakkalın kimdi?"
  },
  {
   "start": 30.43,
   "text": "Adını yorumlara yaz, hatırlayalım."
  }
 ]
}